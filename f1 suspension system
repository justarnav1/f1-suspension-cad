# FLCornerV1 -- original single-seater front-left suspension concept.
# Run inside Autodesk Fusion: Utilities > Scripts and Add-Ins > Scripts.
# No third-party Python packages. Engineering math: m, N, kg, rad.
# Fusion geometry API: cm. User-facing length parameters: mm.
# Editing fl_* parameters and running again creates a NEW updated design.
# Existing designs are never deleted. Not a fabrication/track-use release.

import math
import os
import csv
import traceback
import adsk.core
import adsk.fusion

FORCE_DEFAULTS = False
CREATE_NATIVE_JOINTS = True
TRANSLUCENT_TYRE = True
TRY_HELICAL_SWEEP = True
TAG = 'FLCornerV1'
X, Y, Z = (1., 0., 0.), (0., 1., 0.), (0., 0., 1.)
WARNINGS = []


def mm(v): return v / 1000.0

def add(a, b): return tuple(a[i] + b[i] for i in range(3))

def sub(a, b): return tuple(a[i] - b[i] for i in range(3))

def mul(a, s): return tuple(v * s for v in a)

def dot(a, b): return sum(a[i] * b[i] for i in range(3))

def cross(a, b):
    return (a[1]*b[2]-a[2]*b[1], a[2]*b[0]-a[0]*b[2],
            a[0]*b[1]-a[1]*b[0])

def norm(a): return math.sqrt(dot(a, a))

def unit(a):
    n = norm(a)
    if n < 1e-12: raise ValueError('Zero-length direction or coincident points.')
    return mul(a, 1/n)

def mid(a, b): return mul(add(a, b), .5)

def distance(a, b): return norm(sub(a, b))

def off(p, axis, length): return add(p, mul(axis, length))

def perpendicular(a):
    return unit(cross(a, X if abs(dot(unit(a), X)) < .8 else Y))

def rotate(v, axis, angle):
    a = unit(axis); c = math.cos(angle); s = math.sin(angle)
    return add(add(mul(v, c), mul(cross(a, v), s)),
               mul(a, dot(a, v)*(1-c)))

def rotvec(v, r):
    a = norm(r)
    return rotate(v, r, a) if a > 1e-14 else v

def point(p): return adsk.core.Point3D.create(*(100*x for x in p))

def vector(v): return adsk.core.Vector3D.create(*v)


