def make_spring(c,p,a,b,d,wire):
    occ=c.start('spring','09 Coil spring - regenerated with bump','spring',('Steel',))
    radius=p['spring_mean_diameter']/2; turns=p['spring_turns']
    span=distance(a,b); u=perpendicular(d); start=off(a,u,radius)
    spring_ok=False
    if TRY_HELICAL_SWEEP:
        try:
            helix=c.tm.createHelixWire(point(a),vector(d),point(start),100*span/turns,turns,0.)
            if helix is None: raise RuntimeError('Helix creation returned null.')
            edge=helix.edges.item(0); ev=edge.evaluator
            ok,t0,t1=ev.getParameterExtents()
            if not ok: raise RuntimeError('Cannot evaluate helix.')
            ok,sp=ev.getPointAtParameter(t0); ok2,tangent=ev.getFirstDerivative(t0)
            if not ok or not ok2: raise RuntimeError('Cannot evaluate helix tangent.')
            tangent.normalize()
            circle=adsk.core.Circle3D.createByCenter(sp,tangent,100*wire/2)
            profile_wire,edge_map=c.tm.createWireFromCurves([circle])
            face=c.tm.createFaceFromPlanarWires([profile_wire])
            c.put(helix,'Spring construction helix'); c.put(face,'Spring sweep section')
            feat=c.base; c.finish()
            path_body=feat.bodies.item(0); section_body=feat.bodies.item(1)
            path=occ.component.features.createPath(path_body.edges.item(0),False)
            sweeps=occ.component.features.sweepFeatures
            inp=sweeps.createInput(section_body.faces.item(0),path,
                                  adsk.fusion.FeatureOperations.NewBodyFeatureOperation)
            sweep=sweeps.add(inp); sweep.name='Continuous helical spring'
            if sweep.bodies.count != 1: raise RuntimeError('Spring sweep did not make one body.')
            spring=sweep.bodies.item(0); spring.name='Active helical spring turns'
            if 'spring' in c.styles: spring.appearance=c.styles['spring']
            path_body.isLightBulbOn=False; section_body.isLightBulbOn=False
            spring_ok=True
        except Exception as e:
            WARNINGS.append('Helical sweep fallback used: '+str(e))
            c.finish()
            for body in occ.component.bRepBodies: body.isLightBulbOn=False
    if not spring_ok:
        c.finish()
        # Robust continuous faceted helix fallback, not a stack of floating rings.
        c.current=occ.component; c.names=[]; c.style='spring'
        c.base=c.current.features.baseFeatures.add(); c.base.name='Segmented helix fallback'; c.base.startEdit()
        v=unit(cross(d,u)); count=max(96,int(turns*24)); prev=None
        for i in range(count+1):
            theta=2*math.pi*turns*i/count
            pos=add(off(a,d,span*i/count),
                    add(mul(u,radius*math.cos(theta)),mul(v,radius*math.sin(theta))))
            if prev is not None:
                c.put(c.cyl(prev,pos,wire/2),'Spring wire segment %03d'%i)
            c.put(c.sphere(pos,wire/2),'Spring wire junction %03d'%i)
            prev=pos
        c.finish()
    c.current=occ.component; c.names=[]; c.style='spring'
    c.base=c.current.features.baseFeatures.add(); c.base.name='Closed spring ends'; c.base.startEdit()
    for i,pt in enumerate((a,b)):
        ring=c.tm.createTorus(point(pt),vector(d),100*radius,100*wire/2)
        c.put(ring,'Closed end coil '+str(i+1))
    c.finish()


def build_wheel(c,p,q,n):
    w=q['W']; inside=p['rim_inside']; rr=p['rim_radius']; width=p['rim_width']
    c.start('hub','11 Wheel hub, hollow spindle and drive flange','steel',('Steel',))
    shaft=c.ring(off(w,n,mm(6)),n,mm(236),mm(27.8),mm(19))
    flange=c.ring(off(w,n,mm(99)),n,mm(12),mm(72),mm(19))
    c.put(c.union(shaft,flange),'Hollow hub spindle and outboard wheel flange')
    c.put(c.ring(off(w,n,mm(121)),n,mm(16),mm(36),mm(28)), 'Centre-lock nut proxy')
    radial=perpendicular(n); other=unit(cross(n,radial))
    for i in range(6):
        ang=2*math.pi*i/6; pcd=add(mul(radial,mm(53)*math.cos(ang)),mul(other,mm(53)*math.sin(ang)))
        pt=add(off(w,n,mm(105)),pcd)
        c.put(c.cyl(off(pt,n,-mm(5)),off(pt,n,mm(10)),mm(5)), 'Wheel drive pin '+str(i+1))
    c.finish()
    c.start('wheel','12 18-inch-style open-spoke wheel','alloy',('Aluminum 6061',))
    body=c.ring(w,n,width,rr,inside)
    for sign in (-1,1):
        body=c.union(body,c.ring(off(w,n,sign*(width/2-mm(3))),n,mm(6),rr+mm(10),inside))
    disk=off(w,n,mm(109))
    for i in range(6):
        angle=2*math.pi*i/6
        v=add(mul(radial,math.cos(angle)),mul(other,math.sin(angle)))
        body=c.union(body,c.capsule(off(disk,v,mm(60)),off(disk,v,inside+mm(2)),n,mm(27),mm(8)))
    body=c.union(body,c.ring(disk,n,mm(8),mm(73),mm(28)))
    # Actual drive-pin holes, rather than pins intersecting a solid wheel centre.
    for i in range(6):
        ang=2*math.pi*i/6
        pt=add(disk,add(mul(radial,mm(53)*math.cos(ang)),mul(other,mm(53)*math.sin(ang))))
        c.cut(body,c.cyl(off(pt,n,-mm(15)),off(pt,n,mm(15)),mm(5.15)))
    c.put(body,'Barrel, rounded lips and six open spokes'); c.finish()
    occ=c.start('tyre','13 Tyre clearance envelope - hide for detail','rubber',('Rubber',))
    half=p['tyre_width']/2; shoulder=mm(35); radius=p['wheel_radius']
    tire=c.cyl(off(w,n,-half+shoulder),off(w,n,half-shoulder),radius)
    for sign in (-1,1):
        tire=c.union(tire,c.cyl(off(w,n,sign*(half-shoulder)),off(w,n,sign*half),radius,radius-mm(20)))
    c.cut(tire,c.cyl(off(w,n,-half-mm(1)),off(w,n,half+mm(1)),rr+mm(10)))
    # Hollow carcass, with sidewalls and bead webs touching the rim lips.
    cavity_end=width/2-mm(10)
    cavity=c.cyl(off(w,n,-cavity_end),off(w,n,cavity_end),radius-mm(12))
    for sign in (-1,1):
        cavity=c.union(cavity,c.cyl(off(w,n,sign*cavity_end),
            off(w,n,sign*(half-mm(8))),radius-mm(12),radius-mm(40)))
    c.cut(tire,cavity)
    for sign in (-1,1):
        a=off(w,n,sign*(width/2-mm(3))); b=off(w,n,sign*(half-mm(6)))
        web=c.cut(c.cyl(a,b,rr+mm(18),radius-mm(32)),
                  c.cyl(a,b,rr+mm(10),radius-mm(40)))
        tire=c.union(tire,web,c.ring(a,n,mm(8),rr+mm(20),rr+mm(10)))
    c.put(tire,'Hollow tyre carcass, sidewalls and bead seats'); c.finish()
    if TRANSLUCENT_TYRE:
        try: occ.component.opacity=.20
        except Exception: WARNINGS.append('Set tyre component opacity manually to 20%.')


def sketch_anchor(occ,p,n=None,name='Joint datum'):
    comp=occ.component
    # Offset XY plane keeps the point unambiguously on a 2D sketch plane.
    ci=comp.constructionPlanes.createInput()
    ci.setByOffset(comp.xYConstructionPlane,adsk.core.ValueInput.createByReal(100*p[2]))
    plane=comp.constructionPlanes.add(ci); plane.name=name+' plane'
    sketch=comp.sketches.add(plane); sketch.name=name
    sp=sketch.sketchPoints.add(sketch.modelToSketchSpace(point(p)))
    sketch.isLightBulbOn=False; plane.isLightBulbOn=False
    proxy=sp.createForAssemblyContext(occ)
    axis=None
    if n is not None:
        # Use a 3D construction line; the second datum uses its own offset plane.
        pp=off(p,n,mm(30)); cp=comp.constructionPlanes.createInput()
        cp.setByOffset(comp.xYConstructionPlane,adsk.core.ValueInput.createByReal(100*pp[2]))
        pl=comp.constructionPlanes.add(cp); pl.name=name+' axis end plane'
        sk=comp.sketches.add(pl); sk.name=name+' axis end'
        sp2=sk.sketchPoints.add(sk.modelToSketchSpace(point(pp)))
        ai=comp.constructionAxes.createInput(); ai.setByTwoPoints(sp,sp2)
        axis=comp.constructionAxes.add(ai); axis.name=name+' axis'
        axis.isLightBulbOn=False; sk.isLightBulbOn=False; pl.isLightBulbOn=False
        axis=axis.createForAssemblyContext(occ)
    return adsk.fusion.JointGeometry.createByPoint(proxy),axis


def add_joints(c,h,q,n):
    if not CREATE_NATIVE_JOINTS: return
    dirs=adsk.fusion.JointDirections
    specs=[
        ('Upper inner pivot','U','chassis','rev','UF',unit(sub(h['UR'],h['UF']))),
        ('Lower inner pivot','L','chassis','rev','LF',unit(sub(h['LR'],h['LF']))),
        ('Upper outer spherical','upright','U','ball','U',None),
        ('Lower outer spherical','upright','L','ball','L',None),
        ('Tie inner spherical','tie','chassis','ball','TI',None),
        ('Tie outer spherical','tie','upright','ball','T',None),
        ('Rocker pivot','rocker','chassis','rev','RP',X),
        ('Pushrod lower spherical','pushrod','upright','ball','P',None),
        ('Pushrod upper spherical','pushrod','rocker','ball','RI',None),
        ('Damper fixed spherical','damper','chassis','ball','D',None),
        ('Damper sliding shaft','shaft','damper','cyl','D',unit(sub(q['RO'],q['D']))),
        ('Damper rocker spherical','shaft','rocker','ball','RO',None),
        ('Wheel bearing rotation','hub','upright','rev','W',n),
        ('Wheel flange','wheel','hub','rigid','W',None),
        ('Tyre bead attachment','tyre','wheel','rigid','W',None),
        ('Spring visual attachment','spring','damper','rigid','D',None),
    ]
    for name,a,b,kind,key,direction in specs:
        try:
            geometry,axis=(None,None) if kind=='rigid' else sketch_anchor(c.parts[a],q[key],direction,name)
            ji=c.root.asBuiltJoints.createInput(c.parts[a],c.parts[b],geometry)
            if kind=='rev': ok=ji.setAsRevoluteJointMotion(dirs.CustomJointDirection,axis)
            elif kind=='cyl': ok=ji.setAsCylindricalJointMotion(dirs.CustomJointDirection,axis)
            elif kind=='ball': ok=ji.setAsBallJointMotion(dirs.ZAxisJointDirection,dirs.XAxisJointDirection)
            else: ok=ji.setAsRigidJointMotion()
            if not ok: raise RuntimeError('Joint motion definition rejected.')
            jt=c.root.asBuiltJoints.add(ji)
            if not jt: raise RuntimeError('Joint creation returned null.')
            jt.name=name
        except Exception as e:
            WARNINGS.append('Native joint '+name+': '+str(e))
    # The coil is a visual solid, not a deformable solver element. Use fl_bump.


