def report(p,h,rows,mr,wire,clearance,barrel,mass):
    kw=p['spring_N_per_mm']*mr*mr; freq=math.sqrt(kw*1000/mass)/(2*math.pi)
    slope_u=(h['UR'][2]-h['UF'][2])/(h['UR'][0]-h['UF'][0])
    slope_l=(h['LR'][2]-h['LF'][2])/(h['LR'][0]-h['LF'][0])
    anti=-.5*(slope_u+slope_l)*p['wheelbase']/p['cg_height']*p['front_brake_fraction']*100
    text=('FLCornerV1 - CONCEPT, NOT STRUCTURAL CERTIFICATION\n'
          'Motion ratio = spring compression / upward wheel travel.\n'
          'Static motion ratio: %.5f\nSpring rate: %.2f N/mm\nWheel rate: %.2f N/mm\n'
          'Assumed sprung corner mass: %.2f kg\nUndamped ride frequency: %.3f Hz\n'
          'Calculated spring wire diameter (G=79 GPa): %.3f mm\n'
          'Approximate parallel-axis anti-dive: %.2f %%\n'
          'Sampled non-connected link clearance: %.2f mm\n'
          'Sampled link-to-barrel radial clearance: %.2f mm\n'
          'Clearance checks are limited centreline-envelope checks, NOT a full collision certification.\n'
          'Anti-dive estimate assumes parallel inner hinge axes and outboard front brakes.\n'
          'No tyre stiffness, chassis compliance, damping, aero map or structural FEA is included.\n'
          'Native joints do not deform the coil: use fl_bump and rerun.\n\n') % (
              mr,p['spring_N_per_mm'],kw,mass,freq,wire*1000,anti,clearance*1000,barrel*1000)
    text+='Bump_mm, Camber_deg, ToeIn_deg, Heave_RC_mm, DamperLength_mm, Rocker_deg\n'
    for row in rows:
        text+='%.3f, %.5f, %.5f, %.3f, %.3f, %.3f\n'%(row[0]*1000,
            math.degrees(row[1]),math.degrees(row[2]),row[3]*1000,row[4]*1000,math.degrees(row[5]))
    if WARNINGS: text+='\nWARNINGS:\n'+'\n'.join(WARNINGS)+'\n'
    folder=os.path.join(os.path.expanduser('~'),'Downloads','FLCornerV1_reports')
    try:
        os.makedirs(folder,exist_ok=True)
        with open(os.path.join(folder,'engineering_report.txt'),'w',encoding='utf-8') as f: f.write(text)
        with open(os.path.join(folder,'hardpoints_static_mm.csv'),'w',newline='',encoding='utf-8') as f:
            wr=csv.writer(f); wr.writerow(['Point','X_mm','Y_mm','Z_mm'])
            for key,pt in h.items(): wr.writerow([key]+[round(v*1000,6) for v in pt])
    except Exception as e:
        WARNINGS.append('Could not write report files: '+str(e)); folder='Report file unavailable; see Text Commands.'
    try:
        pal=adsk.core.Application.get().userInterface.palettes.itemById('TextCommands')
        if pal: pal.writeText(text)
    except Exception: pass
    return folder


def run(context):
    global WARNINGS
    WARNINGS=[]; app=adsk.core.Application.get(); ui=app.userInterface; cad=None
    try:
        design,p=read_parameters(app); h=hardpoints(p)
        checks=validate(p,h); rows,mr,wire,clearance,barrel,mass=checks
        q,r=solve_pose(h,p['bump']); solve_rocker(h,q); n=axle(p,r)
        cad=CAD(design)
        build_chassis(cad,p,h)
        build_arm(cad,p,h,q,'U','02 Upper wishbone')
        build_arm(cad,p,h,q,'L','03 Lower wishbone')
        build_upright(cad,p,q,r,n)
        build_link(cad,p,q,'pushrod','P','RI','pushrod','05 Pushrod')
        build_rocker(cad,p,q)
        build_damper(cad,p,q,wire)
        build_link(cad,p,q,'tie','TI','T','tie','10 Steering tie rod')
        build_wheel(cad,p,q,n)
        references(cad,p,h,q); add_joints(cad,h,q,n)
        for name,value,units in (('mr_actual',mr,''),('wheel_rate_N_per_mm',p['spring_N_per_mm']*mr*mr,'')):
            design.userParameters.add('fl_'+name,adsk.core.ValueInput.createByReal(value),units,
                                      'Calculated OUTPUT; overwritten in the next generated design.')
        cam=app.activeViewport.camera
        cam.eye=point((1.7,-1.2,1.2)); cam.target=point((0.,.55,.36)); cam.upVector=vector(Z)
        cam.isFitView=True; app.activeViewport.camera=cam; app.activeViewport.fit(); app.activeViewport.refresh()
        folder=report(p,h,rows,mr,wire,clearance,barrel,mass)
        msg=('Front-left suspension generated.\n\nBump: %.1f mm\nMotion ratio: %.3f\n'
             'Wheel rate: %.1f N/mm\n\nReport: %s\n\n'
             'Save this design. To change geometry: Modify > Change Parameters, edit fl_* and rerun.\n'
             'Rerunning creates a NEW updated design and preserves this one.')%(
                 p['bump']*1000,mr,p['spring_N_per_mm']*mr*mr,folder)
        if WARNINGS: msg+='\n\nWarnings (%d):\n'%len(WARNINGS)+'\n'.join(WARNINGS[:5])
        ui.messageBox(msg,TAG)
    except Exception:
        try:
            if cad: cad.finish()
        except Exception: pass
        ui.messageBox('Build stopped. The incomplete design is left open for inspection.\n\n'+
                      traceback.format_exc(),TAG+' error')


def stop(context):
    pass
