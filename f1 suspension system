def read_parameters(app):
    previous = {}
    active = adsk.fusion.Design.cast(app.activeProduct)
    if (not FORCE_DEFAULTS and active and
            active.rootComponent.attributes.itemByName(TAG, 'generator')):
        for name, expression, units, comment in parameter_spec():
            par = active.userParameters.itemByName('fl_'+name)
            if par: previous[name] = par.expression
    app.documents.add(adsk.core.DocumentTypes.FusionDesignDocumentType)
    design = adsk.fusion.Design.cast(app.activeProduct)
    if not design: raise RuntimeError('A Fusion Design document could not be created.')
    design.designType = adsk.fusion.DesignTypes.ParametricDesignType
    design.fusionUnitsManager.distanceDisplayUnits = adsk.fusion.DistanceUnits.MillimeterDistanceUnits
    design.rootComponent.name = 'FLCornerV1 - Front Left - Engineering Concept'
    design.rootComponent.attributes.add(TAG, 'generator', '1')
    # Allocate every name BEFORE applying expressions, avoiding forward references.
    for name, expression, units, comment in parameter_spec():
        design.userParameters.add('fl_'+name,
            adsk.core.ValueInput.createByString('1 '+units if units else '1'),
            units, comment)
    # Resolve formulas in dependency order, including user-edited dependencies.
    pending = list(parameter_spec())
    for attempt in range(len(pending)+1):
        next_pending = []
        for name, expression, units, comment in pending:
            try:
                design.userParameters.itemByName('fl_'+name).expression = previous.get(name, expression)
            except RuntimeError:
                next_pending.append((name, expression, units, comment))
        if not next_pending: break
        if len(next_pending) == len(pending):
            raise ValueError('Invalid or cyclic parameter expression: '+next_pending[0][0])
        pending = next_pending
    p = {}
    for name, expression, units, comment in parameter_spec():
        val = design.userParameters.itemByName('fl_'+name).value
        p[name] = val*.01 if units == 'mm' else val
    return design, p


def hardpoints(p):
    keys = ('W','UF','UR','LF','LR','U','L','T','TI','P','RP','RI','RO','D')
    return {k: tuple(p[k+'_'+a] for a in 'xyz') for k in keys}


def linear_solve(a, b):
    n = len(b); m = [list(a[i])+[b[i]] for i in range(n)]
    for k in range(n):
        r = max(range(k,n), key=lambda i: abs(m[i][k]))
        if abs(m[r][k]) < 1e-14: raise ValueError('Kinematic Jacobian is singular.')
        m[k], m[r] = m[r], m[k]
        pivot = m[k][k]; m[k] = [v/pivot for v in m[k]]
        for i in range(n):
            if i != k:
                q = m[i][k]
                m[i] = [m[i][j]-q*m[k][j] for j in range(n+1)]
    return [m[i][-1] for i in range(n)]


def solve_pose(h, bump):
    # Six constraints: four wishbone-leg distances, tie-rod length, wheel Z.
    pairs = (('U','UF'),('U','UR'),('L','LF'),('L','LR'),('T','TI'))
    lengths = [distance(h[a], h[b]) for a,b in pairs]
    def moved(v, key):
        return add(add(h['W'], tuple(v[:3])), rotvec(sub(h[key],h['W']), v[3:]))
    def residual(v):
        f = [distance(moved(v,a),h[b])-lengths[i] for i,(a,b) in enumerate(pairs)]
        return f+[v[2]-bump]
    v = [0.,0.,bump,0.,0.,0.]
    for iteration in range(40):
        f = residual(v)
        if max(abs(x) for x in f) < 1e-10: break
        columns = []
        for j in range(6):
            eps = 1e-7 if j < 3 else 1e-6
            test = v[:]; test[j] += eps; ff = residual(test)
            columns.append([(ff[i]-f[i])/eps for i in range(6)])
        jac = [[columns[j][i] for j in range(6)] for i in range(6)]
        delta = linear_solve(jac, [-x for x in f])
        old = norm(tuple(f[:3]))**2 + sum(x*x for x in f[3:])
        scale = 1.
        while scale > 1/256:
            trial = [v[i]+scale*delta[i] for i in range(6)]
            if sum(x*x for x in residual(trial)) < old: break
            scale *= .5
        v = trial
    if max(abs(x) for x in residual(v)) > 1e-8:
        raise ValueError('Suspension pose did not converge; restore valid hard points.')
    q = dict(h)
    for k in ('W','U','L','T','P'): q[k] = moved(v,k)
    return q, tuple(v[3:])


def solve_rocker(h, q):
    arm = sub(h['RI'],h['RP']); length = distance(h['RI'],h['P'])
    angle = 0.
    for iteration in range(30):
        r = rotate(arm, X, angle); end = add(h['RP'],r)
        delta = sub(end,q['P']); ln = norm(delta)
        err = ln-length
        if abs(err) < 1e-11: break
        derivative = dot(unit(delta),cross(X,r))
        if abs(derivative) < 1e-6: raise ValueError('Pushrod/rocker is near a toggle.')
        step = max(-.15,min(.15,err/derivative)); angle -= step
    if abs(distance(end,q['P'])-length) > 1e-8:
        raise ValueError('Rocker length constraint did not converge.')
    if abs(angle) > math.radians(35): raise ValueError('Excessive rocker rotation.')
    for k in ('RI','RO'):
        q[k] = add(h['RP'],rotate(sub(h[k],h['RP']),X,angle))
    return angle, distance(q['RO'],h['D'])


def axle(p, rotation=(0.,0.,0.)):
    c, t = -p['camber'], p['toe']
    return rotvec((math.sin(t)*math.cos(c),math.cos(t)*math.cos(c),math.sin(c)),rotation)


def roll_centre(h, q, radius):
    # Front-view construction for a mirrored axle in symmetric heave, zero steer.
    lines = []
    for outer,a,b in (('U','UF','UR'),('L','LF','LR')):
        axis = unit(sub(h[b],h[a])); o = q[outer]
        inside = off(h[a],axis,dot(sub(o,h[a]),axis))
        lines.append((o,sub(inside,o)))
    a,v = lines[0]; b,w = lines[1]
    t = linear_solve([[v[1],-w[1]],[v[2],-w[2]]],
                     [b[1]-a[1],b[2]-a[2]])[0]
    ic = off(a,v,t)
    ground = q['W'][2]-radius
    if abs(q['W'][1]-ic[1]) < 1e-6: raise ValueError('Undefined roll centre.')
    return (ic[2]-ground)*q['W'][1]/(q['W'][1]-ic[1])


def arm_shape(h, q, which):
    a,b,o = (q[k] for k in ((which+'F'),(which+'R'),which))
    axis = unit(sub(b,a))
    # Short straight bearing necks avoid clevis interference at angled tube ends.
    def neck(p, target):
        d = sub(target,p); d = sub(d,mul(axis,dot(d,axis)))
        return off(p,unit(d),mm(42))
    junction = neck(o,mid(a,b))
    af,br = neck(a,junction),neck(b,junction)
    return a,b,o,af,br,junction,axis


def segment_distance(a,b,c,d):
    u,v,w = sub(b,a),sub(d,c),sub(a,c)
    aa,bb,cc,dd,ee = dot(u,u),dot(u,v),dot(v,v),dot(u,w),dot(v,w)
    den = aa*cc-bb*bb
    s = max(0.,min(1.,(bb*ee-cc*dd)/den)) if den > 1e-20 else 0.
    t = (bb*s+ee)/cc
    if t < 0.: t=0.; s=max(0.,min(1.,-dd/aa))
    elif t > 1.: t=1.; s=max(0.,min(1.,(bb-dd)/aa))
    return distance(off(a,u,s),off(c,v,t))


def validate(p,h):
    if abs(p['bump']) > p['travel']+1e-9: raise ValueError('fl_bump exceeds +/-fl_travel.')
    if not .15 < p['wheel_radius'] < .5: raise ValueError('Invalid wheel radius.')
    if not 0 < p['rim_inside'] < p['rim_radius'] < p['wheel_radius']-mm(20):
        raise ValueError('Rim/tyre radii are incompatible.')
    if p['tyre_width'] < p['rim_width']+mm(20):
        raise ValueError('V1 tyre must be at least 20 mm wider than the rim.')
    if p['spring_turns'] < 2 or p['spring_N_per_mm'] <= 0:
        raise ValueError('Invalid spring specification.')
    for name in ('upper','lower','pushrod','tie'):
        if not 0 < p[name+'_wall'] < p[name+'_OD']/2:
            raise ValueError('Invalid tube wall for '+name)
    for key in ('RI','RO','D'):
        if abs(h[key][0]-h['RP'][0]) > 1e-6:
            raise ValueError('V1 rocker and damper must remain in the RP YZ plane.')
    rows = []; min_clear = float('inf'); min_barrel = float('inf')
    spring_wire = (8*p['spring_mean_diameter']**3*p['spring_turns']*
                   p['spring_N_per_mm']*1000/79e9)**.25
    for i in range(9):
        dz = -p['travel']+i*p['travel']/4
        q,r = solve_pose(h,dz); angle,length = solve_rocker(h,q); n=axle(p,r)
        if not mm(225) < length < mm(285):
            raise ValueError('V1 damper packaging requires eye lengths between 225 and 285 mm.')
        if abs(length-p['damper_length']) > p['damper_stroke']/2-mm(2):
            raise ValueError('Damper reaches its stroke limit within specified wheel travel.')
        if length-mm(60) < (p['spring_turns']+2)*spring_wire+mm(8):
            raise ValueError('Insufficient spring coil-bind clearance.')
        lines=[]
        for which,name in (('U','upper'),('L','lower')):
            a,b,o,af,br,j,axis=arm_shape(h,q,which)
            lines += [(which,af,j,p[name+'_OD']/2),(which,br,j,p[name+'_OD']/2)]
        lines += [('push',q['P'],q['RI'],p['pushrod_OD']/2),
                  ('tie',q['TI'],q['T'],p['tie_OD']/2)]
        for j,(name,a,b,rad) in enumerate(lines):
            for name2,c,d,rad2 in lines[j+1:]:
                if name != name2:
                    min_clear=min(min_clear,segment_distance(a,b,c,d)-rad-rad2)
            for k in range(61):
                pt=add(a,mul(sub(b,a),k/60)); dv=sub(pt,q['W']); axial=dot(dv,n)
                if abs(axial) <= p['rim_width']/2+rad:
                    radial=norm(sub(dv,mul(n,axial)))
                    min_barrel=min(min_barrel,p['rim_inside']-radial-rad)
        rows.append((dz, -math.asin(max(-1.,min(1.,n[2]))),
                     math.atan2(n[0],n[1]),roll_centre(h,q,p['wheel_radius']),length,angle))
    if min_clear < mm(3): raise ValueError('Non-connected links have less than 3 mm clearance.')
    if min_barrel < mm(5): raise ValueError('A suspension link approaches/intersects the rim barrel.')
    dl=[]
    for dz in (-mm(.1),mm(.1)):
        q,r=solve_pose(h,dz); dl.append(solve_rocker(h,q)[1])
    mr=-(dl[1]-dl[0])/mm(.2)
    if not .2 < mr < 1.5: raise ValueError('Implausible or reversed motion ratio.')
    mass=p['mass_kg']*p['front_fraction']/2-p['unsprung_kg']
    if mass <= 0: raise ValueError('Invalid assumed sprung corner mass.')
    return rows,mr,spring_wire,min_clear,min_barrel,mass


class CAD:
    def __init__(self, design):
        self.design=design; self.root=design.rootComponent
        self.tm=adsk.fusion.TemporaryBRepManager.get()
        self.parts={}; self.styles={}; self.current=None; self.base=None; self.names=[]
        self._styles()

    def _styles(self):
        colors={'frame':(55,62,70),'arm':(45,48,54),'alloy':(170,178,187),
                'steel':(115,128,142),'spring':(210,43,38),'damper':(186,133,47),
                'rubber':(25,27,30)}
        source=None
        try:
            for lib in adsk.core.Application.get().materialLibraries:
                for name in ('Paint - Enamel Glossy (Yellow)','Paint - Enamel Glossy (Black)',
                             'Aluminum - Satin','Steel - Satin'):
                    source=lib.appearances.itemByName(name)
                    if source: break
                if source: break
            if not source: return
            for key,rgb in colors.items():
                ap=self.design.appearances.addByCopy(source,TAG+'_'+key)
                for prop in ap.appearanceProperties:
                    cp=adsk.core.ColorProperty.cast(prop)
                    if cp:
                        cp.value=adsk.core.Color.create(*rgb,255); break
                self.styles[key]=ap
        except Exception as e:
            WARNINGS.append('Appearance library fallback: '+str(e))

    def material(self, comp, names):
        try:
            for lib in adsk.core.Application.get().materialLibraries:
                for name in names:
                    mat=lib.materials.itemByName(name)
                    if mat: comp.material=mat; return
        except Exception:
            pass  # Library availability must not prevent geometry creation.

    def start(self,key,name,style='alloy',material=('Aluminum 6061',)):
        self.finish()
        occ=self.root.occurrences.addNewComponent(adsk.core.Matrix3D.create())
        occ.component.name=name; self.parts[key]=occ; self.current=occ.component
        try: occ.isGroundToParent=False
        except AttributeError: pass
        occ.isGrounded=False
        self.material(self.current,material)
        self.style=style; self.names=[]
        self.base=self.current.features.baseFeatures.add(); self.base.name=name+' solids'
        if not self.base.startEdit(): raise RuntimeError('Cannot edit BaseFeature: '+name)
        return occ

    def put(self,body,name,style=None):
        if body is None: raise RuntimeError('Empty body: '+name)
        out=self.current.bRepBodies.add(body,self.base)
        if out is None: raise RuntimeError('Could not persist body: '+name)
        out.name=name; ap=self.styles.get(style or self.style)
        if ap: out.appearance=ap
        self.names.append((name,style or self.style))
        return out

    def finish(self):
        if self.base:
            base=self.base; self.base=None
            if not base.finishEdit(): raise RuntimeError('Could not finish BaseFeature.')
            # Name/style the RESULT bodies, not only the editable source bodies.
            for i,(name,style) in enumerate(self.names):
                if i < base.bodies.count:
                    b=base.bodies.item(i); b.name=name
                    if style in self.styles: b.appearance=self.styles[style]
            adsk.doEvents()

    def boolean(self,a,b,op):
        if a is None or b is None or not self.tm.booleanOperation(a,b,op):
            raise RuntimeError('BRep Boolean operation failed; inspect edited dimensions.')
        return a

    def union(self,*bodies):
        result=bodies[0]
        for b in bodies[1:]: self.boolean(result,b,adsk.fusion.BooleanTypes.UnionBooleanType)
        return result

    def cut(self,a,b): return self.boolean(a,b,adsk.fusion.BooleanTypes.DifferenceBooleanType)

    def intersect(self,a,b): return self.boolean(a,b,adsk.fusion.BooleanTypes.IntersectionBooleanType)

    def cyl(self,a,b,r,r2=None):
        if distance(a,b)<1e-7 or r<=0: raise ValueError('Invalid cylinder.')
        return self.tm.createCylinderOrCone(point(a),100*r,point(b),100*(r if r2 is None else r2))

    def ring(self,p,n,length,outer,inner):
        return self.cut(self.cyl(off(p,n,-length/2),off(p,n,length/2),outer),
                        self.cyl(off(p,n,-length/2-mm(.2)),off(p,n,length/2+mm(.2)),inner))

    def sphere(self,p,r): return self.tm.createSphere(point(p),100*r)

    def box(self,p,l,w,t,along=X,across=Y):
        a=unit(along); b=unit(sub(across,mul(a,dot(across,a))))
        bb=adsk.core.OrientedBoundingBox3D.create(point(p),vector(a),vector(b),100*l,100*w,100*t)
        return self.tm.createBox(bb)

    def capsule(self,a,b,n,width,thick):
        d=unit(sub(b,a)); side=unit(cross(n,d))
        return self.union(self.box(mid(a,b),distance(a,b),width,thick,d,side),
            self.cyl(off(a,n,-thick/2),off(a,n,thick/2),width/2),
            self.cyl(off(b,n,-thick/2),off(b,n,thick/2),width/2))

    def tube(self,a,b,outer,wall):
        d=unit(sub(b,a))
        return self.cut(self.cyl(a,b,outer/2),
                        self.cyl(off(a,d,-mm(.2)),off(b,d,mm(.2)),outer/2-wall))

    def eye_blank(self,p,n): return self.cyl(off(p,n,-mm(7)),off(p,n,mm(7)),mm(17))

    def eye_cut(self,body,p,n):
        self.cut(body,self.sphere(p,mm(12.10)))
        return self.cut(body,self.cyl(off(p,n,-mm(20)),off(p,n,mm(20)),mm(9)))

    def ball_and_pin(self,p,n,label,half_gap=mm(9.1),pin_r=mm(4.95)):
        ball=self.intersect(self.sphere(p,mm(12)),
            self.box(p,mm(18),mm(30),mm(30),n,perpendicular(n)))
        self.cut(ball,self.cyl(off(p,n,-mm(20)),off(p,n,mm(20)),mm(5.1)))
        self.put(ball,label+' spherical inner race','steel')
        half=half_gap+mm(8)
        self.put(self.cyl(off(p,n,-half),off(p,n,half),pin_r),label+' pin','steel')
        for sign in (-1,1):
            self.put(self.ring(off(p,n,sign*(half-mm(1))),n,mm(2),mm(8),mm(5.05)),
                     label+(' washer A' if sign<0 else ' washer B'),'steel')
            self.put(self.cyl(off(p,n,sign*half),off(p,n,sign*(half+mm(4))),mm(8)),
                     label+(' bolt head' if sign<0 else ' nut proxy'),'steel')

    def clevis(self,p,n,back,gap=mm(18.2),width=mm(30),pin=mm(5.1)):
        # Back vector is perpendicular to pin, leaving the bearing articulation gap.
        d=sub(back,p); back=add(p,sub(d,mul(n,dot(d,n))))
        ears=[]
        for sign in (-1,1):
            shift=mul(n,sign*(gap/2+mm(3)))
            ear=self.capsule(add(p,shift),add(back,shift),n,width,mm(6))
            self.cut(ear,self.cyl(off(p,n,-mm(50)),off(p,n,mm(50)),pin))
            ears.append(ear)
        bridge=self.cyl(off(back,n,-gap/2-mm(6)),off(back,n,gap/2+mm(6)),width/2)
        return self.union(ears[0],bridge,ears[1]),back


